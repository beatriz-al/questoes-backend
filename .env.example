# Backblaze B2 — use uma Application Key NORMAL (não a Master Key).
# A Master Key (keyID = Account ID) NÃO funciona na API S3.
#
# Crie em: Application Keys → Add a New Application Key
# - Allow access to Bucket: provas
# - Read and Write
# - Allow List All Bucket Names (se restringir ao bucket)

B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=provas
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
